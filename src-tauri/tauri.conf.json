{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audion",
  "version": "1.3.5",
  "identifier": "com.audion.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Audion",
        "width": 1600,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "backgroundColor": "#121212",
        "visible": true,
        "decorations": false,
        "resizable": true,
        "maximized": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' blob: asset: http://asset.localhost https://asset.localhost; connect-src * asset: http://asset.localhost https://asset.localhost; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost http: https:; media-src 'self' asset: http://asset.localhost https://asset.localhost file: blob: http: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.local/share/com.audion.app/**",
          "$HOME/.local/share/**",
          "$HOME/.config/audion/**",
          "$HOME/.config/com.audion.app/**",
          "$APPDATA/**",
          "$AUDIO/**",
          "$MUSIC/**",
          "**"
        ]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26
    },
    "macOS": {
      "entitlements": "./entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "audion"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "audion"
          ],
          "appLink": false
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGOUJEQkM3NUVCMjAxMTIKUldRU0FiSmV4OXVicjg1U2JuL1pRdGlvWnhTbStucHF5aDVCYkMxZDFRQWRhRi93TGxlTTNqeDEK",
      "endpoints": [
        "https://github.com/SmileofHaven/Audion-Changes/releases/latest/download/latest.json"
      ]
    }
  }
}